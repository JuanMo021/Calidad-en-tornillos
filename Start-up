def asociar(et):
    screws = [p for c, p in et if c == idx_screw]
    asig = [[] for _ in screws]
    if not screws:
        return screws, asig
    for c, p in et:
        if c == idx_screw:
            continue
        cx, cy = map(float, p.mean(axis=0))
        dists = [cv2.pointPolygonTest(s.reshape(-1, 1, 2).astype(np.float32), (cx, cy), True) for s in screws]
        i = int(np.argmax(dists))
        asig[i].append((c, p, dists[i]))
    return screws, asig

def recorte(img, poly, margen=0.15):
    x, y, bw, bh = cv2.boundingRect(poly)
    mx, my = int(bw * margen), int(bh * margen)
    x0, y0 = max(0, x - mx), max(0, y - my)
    x1, y1 = min(img.shape[1], x + bw + mx), min(img.shape[0], y + bh + my)
    return img[y0:y1, x0:x1]

def procesar_split(split):
    X_imgs, y_labels = [], []
    for img_p, lbl_p in rutas(split):
        if not lbl_p.exists():
            continue
        img = cv2.imread(str(img_p))
        if img is None:
            continue
        h, w = img.shape[:2]
        et = leer_etiquetas(lbl_p, w, h)
        screws, asig = asociar(et)
        
        for i, s_poly in enumerate(screws):
            L = max(cv2.boundingRect(s_poly)[2:])
            n_def = sum(1 for c, p, d in asig[i] if d >= -TOL_FRAC * L)
            label = 1 if n_def > 0 else 0
            
            crop = recorte(img, s_poly, margen=0.1)
            if crop.size == 0 or crop.shape[0] < 12 or crop.shape[1] < 12:
                continue
            
            crop_res = cv2.resize(crop, IMG_SIZE)
            crop_rgb = cv2.cvtColor(crop_res, cv2.COLOR_BGR2RGB)
            X_imgs.append(crop_rgb)
            y_labels.append(label)
    return np.array(X_imgs), np.array(y_labels)

