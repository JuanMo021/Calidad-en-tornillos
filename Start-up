def rutas(split):
    carpeta = DATASET / "images" / split
    imgs = sorted(p for p in carpeta.iterdir() if p.suffix.lower() in EXT_IMG)
    return [(p, DATASET / "labels" / split / (p.stem + ".txt")) for p in imgs]


def leer_etiquetas(txt_path, w, h):
    out = []
    texto = Path(txt_path).read_text().strip()
    for linea in texto.splitlines():
        v = linea.split()
        if len(v) < 5:
            continue
        cls = int(v[0])
        vals = np.array(v[1:], dtype=np.float32)
        if len(vals) == 4:
            cx, cy, bw, bh = vals
            pts = np.array([
                [cx - bw / 2, cy - bh / 2],
                [cx + bw / 2, cy - bh / 2],
                [cx + bw / 2, cy + bh / 2],
                [cx - bw / 2, cy + bh / 2]
            ], dtype=np.float32)
        else:
            pts = vals[: len(vals) // 2 * 2].reshape(-1, 2)
        pts[:, 0] *= w
        pts[:, 1] *= h
        out.append((cls, pts.astype(np.int32)))
    return out

COLORES = {
    "head_defect": (0, 0, 255), "neck_defect": (0, 165, 255), "screw": (0, 200, 0),
    "thread_defect": (255, 0, 0), "tip_defect": (255, 0, 255)
}

def dibujar_identificacion(img_p, lbl_p):
    img = cv2.imread(str(img_p))
    h, w = img.shape[:2]
    esc = max(h, w) / 1000
    for cls, pts in leer_etiquetas(lbl_p, w, h):
        nombre = CLASES[cls]
        color = COLORES.get(nombre, (255, 255, 0))
        cv2.polylines(img, [pts], True, color, max(2, int(3 * esc)))
        x, y = int(pts[:, 0].min()), int(pts[:, 1].min())
        cv2.putText(img, nombre, (x, max(y - 10, 25)), cv2.FONT_HERSHEY_SIMPLEX,
                    0.8 * esc, color, max(2, int(2 * esc)))
    return cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

